---
import { ArrowRight, MapPin, Mail } from "lucide-react";
import { siteConfig } from "@/data/site";
---

<section class="relative overflow-hidden border-b border-line">
  <div
    class="pointer-events-none absolute -right-24 top-1/2 hidden -translate-y-1/2 select-none lg:block"
    aria-hidden="true"
  >
    <p
      class="hero-outline text-[9rem] font-extrabold leading-[0.85] tracking-tighter"
      aria-hidden="true"
    >
      BUILD<br />CAPTURE<br />DESIGN<br />TELL
    </p>
  </div>

  <div class="shell pb-20 pt-16 lg:pb-28 lg:pt-24">
    <p class="eyebrow" data-reveal>Portfolio — {siteConfig.availability}</p>

    <h1 class="display-hero mt-6 max-w-5xl" data-reveal>
      {siteConfig.name}
    </h1>

    <div
      class="mt-6 flex flex-wrap items-baseline gap-x-3 gap-y-2 text-xl font-semibold tracking-tight text-neutral-400 sm:text-2xl"
      data-reveal
    >
      <span class="text-white">Creative Developer</span>
      <span class="text-accent">·</span>
      <span>Photographer</span>
      <span class="text-accent">·</span>
      <span>Designer</span>
      <span class="text-accent">·</span>
      <span>Filmmaker</span>
    </div>

    <p
      class="mt-8 max-w-2xl text-base leading-relaxed text-neutral-400 sm:text-lg"
      data-reveal
    >
      {siteConfig.shortBio}
    </p>

    <div class="mt-10 flex flex-wrap gap-4" data-reveal>
      <a href="/work/" class="btn btn-primary">
        Explore Work
        <ArrowRight size={16} />
      </a>
      <a
        href={siteConfig.cvUrl}
        download
        data-track="cv_download"
        class="btn btn-outline"
      >
        Download CV
      </a>
    </div>

    <div
      class="mt-14 flex flex-wrap items-center gap-x-8 gap-y-3 border-t border-line pt-6 text-sm text-neutral-500"
      data-reveal
    >
      <span class="inline-flex items-center gap-2">
        <MapPin size={14} className="text-accent" />
        {siteConfig.location}
      </span>
      <a
        href={`mailto:${siteConfig.email}`}
        class="inline-flex items-center gap-2 transition-colors hover:text-neutral-300"
      >
        <Mail size={14} className="text-accent" />
        {siteConfig.email}
      </a>
      <span
        class="hidden items-center gap-2 uppercase tracking-[0.18em] text-neutral-500 sm:inline-flex"
      >
        {siteConfig.studio.name} — photo · design · film
      </span>
    </div>
  </div>
</section>