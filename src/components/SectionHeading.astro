---
import { ArrowUpRight } from "lucide-react";

interface Props {
  eyebrow: string;
  title: string;
  href?: string;
  linkLabel?: string;
}
const { eyebrow, title, href, linkLabel = "View all" } = Astro.props;
---

<div class="mb-12 flex items-end justify-between gap-6">
  <div data-reveal>
    <p class="eyebrow">{eyebrow}</p>
    <h2 class="display-lg mt-3">{title}</h2>
  </div>
  {
    href && (
      <a
        href={href}
        class="link-underline hidden shrink-0 items-center gap-1 text-sm font-medium text-neutral-400 transition-colors hover:text-white sm:inline-flex"
        data-reveal
      >
        {linkLabel}
        <ArrowUpRight size={15} />
      </a>
    )
  }
</div>