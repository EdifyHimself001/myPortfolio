---
import { FileDown, Mail } from "lucide-react";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { siteConfig } from "@/data/site";
import { skillGroups, toolsList } from "@/data/profile";
---

<BaseLayout
  title="CV"
  description={`Curriculum vitae of ${siteConfig.name} — ${siteConfig.role}.`}
>
  <div class="shell pb-24 pt-16 lg:pb-32 lg:pt-24">
    <header class="max-w-3xl">
      <p class="eyebrow">Curriculum Vitae</p>
      <h1 class="display-hero mt-4" style="font-size: clamp(2.75rem, 8vw, 6rem);">
        CV
      </h1>
      <p class="mt-6 max-w-2xl text-lg leading-relaxed text-neutral-400">
        A printable summary of my skills, tools and disciplines. Replace{" "}
        <code class="rounded bg-white/10 px-1.5 py-0.5 font-mono text-xs text-neutral-300">public/cv/CV_Ackwonu_Edwin_Kwamena.pdf</code>{" "}
        with your own document before going live.
      </p>
      <div class="mt-8 flex flex-wrap gap-4">
        <a
          href={siteConfig.cvUrl}
          download
          data-track="cv_download"
          class="btn btn-primary"
        >
          <FileDown size={15} />
          Download PDF
        </a>
        <a href={`mailto:${siteConfig.email}`} class="btn btn-outline">
          <Mail size={15} />
          Request by Email
        </a>
      </div>
    </header>

    <section class="mt-20 grid gap-10 sm:grid-cols-2" aria-labelledby="cv-skills">
      <h2 id="cv-skills" class="eyebrow sr-only">Skills by discipline</h2>
      {
        skillGroups.map((group) => (
          <div class="border-t border-line pt-6">
            <h3 class="text-base font-bold text-white">{group.title}</h3>
            <ul class="mt-4 space-y-2">
              {group.items.map((item) => (
                <li class="flex items-center gap-2.5 text-sm text-neutral-400">
                  <span class="h-px w-4 bg-accent" aria-hidden="true" />
                  {item}
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </section>

    <section class="mt-16" aria-labelledby="cv-tools">
      <h2 id="cv-tools" class="eyebrow">Tools</h2>
      <ul class="mt-5 flex flex-wrap gap-2">
        {
          toolsList.map((tool) => (
            <li class="chip">{tool}</li>
          ))
        }
      </ul>
    </section>

    <section class="mt-16" aria-labelledby="cv-disciplines">
      <h2 id="cv-disciplines" class="eyebrow">Disciplines</h2>
      <ul class="mt-5 grid gap-4 sm:grid-cols-4">
        {
          ["Build — Web Apps", "Capture — Photography", "Design — Graphics", "Tell — Videography"].map(
            (d) => (
              <li class="border border-line p-5 text-sm font-semibold text-neutral-200">
                {d}
              </li>
            )
          )
        }
      </ul>
    </section>
  </div>
</BaseLayout>