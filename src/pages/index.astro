---
import { Image } from "astro:assets";
import { ArrowRight } from "lucide-react";
import BaseLayout from "@/layouts/BaseLayout.astro";
import Hero from "@/components/Hero.astro";
import JsonLd from "@/components/JsonLd.astro";
import SectionHeading from "@/components/SectionHeading.astro";
import ProjectCard from "@/components/ProjectCard.astro";
import CategoryNavigation from "@/components/CategoryNavigation.astro";
import GitHubRepos from "@/components/GitHubRepos.astro";
import { getWork } from "@/lib/projects";
import { siteConfig } from "@/data/site";
import portrait from "@/assets/portrait.jpg";

const entries = await getWork();
const featured = entries.filter((e) => e.data.featured).slice(0, 4);
const selected =
  featured.length >= 2
    ? featured
    : [...featured, ...entries.filter((e) => !e.data.featured)].slice(0, 4);

const spans = [
  "md:col-span-7",
  "md:col-span-5",
  "md:col-span-5",
  "md:col-span-7",
];
const aspects = [
  "aspect-[16/11]",
  "aspect-[16/11] md:aspect-[4/5]",
  "aspect-[16/11] md:aspect-[4/5]",
  "aspect-[16/11]",
];

const personJsonLd = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: siteConfig.name,
  url: Astro.site?.href,
  jobTitle: siteConfig.role,
  description: siteConfig.shortBio,
  email: `mailto:${siteConfig.email}`,
  address: {
    "@type": "PostalAddress",
    addressLocality: siteConfig.location,
  },
  sameAs: Object.values(siteConfig.social).filter((url) => url !== ""),
};
---

<BaseLayout>
  <Hero />

  <section class="shell mt-24 lg:mt-32" aria-labelledby="featured-heading">
    <div id="featured-heading">
      <SectionHeading
        eyebrow="Selected projects"
        title="Featured Work"
        href="/work/"
        linkLabel="All projects"
      />
    </div>

    <div class="grid gap-x-8 gap-y-14 md:grid-cols-12 lg:gap-x-12">
      {
        selected.map((entry, i) => (
          <ProjectCard
            project={entry}
            class={spans[i] ?? "md:col-span-6"}
            aspect={aspects[i]}
            eager={i === 0}
            sizes="(min-width:768px) 50vw, calc(100vw - 2.5rem)"
          />
        ))
      }
    </div>
  </section>

  <CategoryNavigation />

  <section class="shell mt-24 lg:mt-32" aria-labelledby="about-teaser">
    <div id="about-teaser">
      <SectionHeading eyebrow="About me" title="A One-Person Studio" href="/about/" linkLabel="Full story" />
    </div>

    <div class="grid items-center gap-12 lg:grid-cols-12" data-reveal>
      <div class="lg:col-span-5">
        <div class="overflow-hidden bg-panel ring-1 ring-white/5">
          <Image
            src={portrait}
            alt={`Portrait of ${siteConfig.name}`}
            widths={[480, 720, 960]}
            sizes="(min-width:1024px) 40vw, calc(100vw - 2.5rem)"
            loading="lazy"
            decoding="async"
            class="w-full object-cover"
          />
        </div>
      </div>
      <div class="lg:col-span-7 lg:pl-6">
        {
          siteConfig.tagline.split(" ").map((word) => (
            <span class="eyebrow mr-3">{word}</span>
          ))
        }
        <p class="mt-6 text-xl font-semibold leading-relaxed text-neutral-100 sm:text-2xl">
          Every discipline makes the others stronger. Design teaches me
          structure; photography teaches me light; film teaches me rhythm;
          code lets me put all of it to work.
        </p>
        <p class="mt-6 max-w-2xl leading-relaxed text-neutral-400">
          I take on projects across the full spectrum — from designing a brand
          identity and building the website that carries it, to photographing
          the launch and cutting the story that sells it.
        </p>
        <a href="/about/" class="btn btn-outline mt-10">
          More About Me
          <ArrowRight size={15} />
        </a>
      </div>
    </div>
  </section>

  <GitHubRepos />

  <JsonLd data={personJsonLd} />
</BaseLayout>